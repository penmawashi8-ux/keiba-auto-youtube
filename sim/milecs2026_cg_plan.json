   "dur": 3.936,
   "kind": "call",
   "text": "エンブロイダリーとエコロブルーム！激しい叩き合い！"
  },
  {
   "t": 76.167,
   "file": "voice_e228376132.mp3",
   "dur": 2.832,
   "kind": "call",
   "text": "エンブロイダリー、先頭でゴールイン！"
  },
  {
   "t": 80.75,
